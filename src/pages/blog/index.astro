---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE } from '../../config/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [destaque, ...resto] = posts;
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const blogLd = {
  '@type': 'Blog',
  name: 'Blog Axon',
  url: `${SITE.url}/blog/`,
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE.url}/#organization` },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE.url}/blog/${p.id}/`, datePublished: p.data.pubDate.toISOString().slice(0, 10) })),
};
---
<Base
  title="Blog Axon — IA, WhatsApp e Automação de Atendimento"
  description="Artigos práticos sobre inteligência artificial, atendimento automatizado no WhatsApp e como converter mais clientes. Conteúdo da equipe Axon."
  path="/blog/"
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }]}
  jsonLd={[blogLd]}
>
  <section class="relative overflow-hidden">
    <div class="orbe -top-32 -right-24 size-96 bg-[#d9ccff]" aria-hidden="true"></div>
    <div class="container-x relative pt-14 pb-10 md:pt-20">
      <p class="text-sm font-semibold tracking-wide text-roxo uppercase">Blog</p>
      <h1 class="titulo mt-3 max-w-3xl text-5xl sm:text-6xl">Atendimento no WhatsApp, sem enrolação.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-texto">Guias práticos para responder mais rápido, perder menos clientes e usar inteligência artificial a favor do seu negócio.</p>
    </div>
  </section>

  <div class="container-x">
    {destaque && (
      <a href={`/blog/${destaque.id}/`} class="group relative block overflow-hidden rounded-[2rem] bg-tinta p-8 text-white sm:p-12" data-reveal>
        <div class="orbe -top-24 -right-16 size-96 bg-roxo opacity-60 transition-transform duration-700 group-hover:scale-110" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <p class="text-sm text-ciano">Mais recente · {fmt(destaque.data.pubDate)}</p>
          <h2 class="titulo mt-3 text-4xl sm:text-5xl">{destaque.data.title}</h2>
          <p class="mt-4 leading-relaxed text-white/75">{destaque.data.description}</p>
          <span class="mt-6 inline-block font-semibold text-ciano transition-transform group-hover:translate-x-1">Ler artigo →</span>
        </div>
      </a>
    )}

    <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {resto.map((p, i) => (
        <li data-reveal={(i % 3) * 90}>
          <a href={`/blog/${p.id}/`} class="cartao group flex h-full flex-col p-6 transition-transform duration-300 hover:-translate-y-1">
            <p class="text-xs text-suave">{fmt(p.data.pubDate)}</p>
            <h2 class="mt-2 text-lg leading-snug font-semibold group-hover:text-roxo">{p.data.title}</h2>
            <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-texto">{p.data.description}</p>
            <span class="mt-5 text-sm font-semibold text-roxo">Ler →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <FinalCta origem="blog" />
</Base>
