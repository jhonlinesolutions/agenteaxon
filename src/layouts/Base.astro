---
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Seo, { type Breadcrumb } from '../components/Seo.astro';
import Tracking from '../components/Tracking.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sans400 from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';
import sans600 from '@fontsource/inter-tight/files/inter-tight-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  breadcrumbs?: Breadcrumb[];
  type?: 'website' | 'article';
}

const props = Astro.props;
const path = props.path ?? Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaff" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {[serif400, sans400, sans600].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <Seo {...props} path={path} />
    <Tracking />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Pular para o conteúdo</a>
    <Header path={path} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer path={path} />
    <WhatsAppFloat origem={`flutuante${path}`} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
