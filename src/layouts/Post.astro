---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../config/site';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  related: CollectionEntry<'blog'>[];
  minutes: number;
}

const { post, headings, related, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, ogImage } = post.data;
const path = `/blog/${post.id}/`;
const origem = `blog/${post.id}`;
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const toc = headings.filter((h) => h.depth === 2);

const ld = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString().slice(0, 10),
  dateModified: (updatedDate ?? pubDate).toISOString().slice(0, 10),
  inLanguage: 'pt-BR',
  author: { '@type': 'Organization', name: 'Equipe Axon', url: `${SITE.url}/sobre/` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: new URL(path, SITE.url).href,
  image: new URL(ogImage ?? '/og/axon.png', SITE.url).href,
};
---
<Base title={`${title} | Blog Axon`} description={description} path={path} ogImage={ogImage} type="article" jsonLd={[ld]} breadcrumbs={[{ name: 'Blog', path: '/blog/' }, { name: title, path }]}>
  <article>
    <header class="relative overflow-hidden">
      <div class="orbe -top-32 -right-24 size-96 bg-[#d9ccff]" aria-hidden="true"></div>
      <div class="container-x relative max-w-3xl pt-10 pb-10 md:pt-16">
        <nav aria-label="Você está em" class="text-sm text-suave">
          <a href="/" class="hover:text-roxo">Início</a> <span aria-hidden="true">/</span> <a href="/blog/" class="hover:text-roxo">Blog</a>
        </nav>
        <h1 class="titulo mt-8 text-[2.5rem] sm:text-6xl">{title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-texto">{description}</p>
        <p class="mt-5 text-sm text-suave">
          Equipe Axon · <time datetime={pubDate.toISOString().slice(0, 10)}>{fmt(pubDate)}</time>
          {updatedDate && <> · atualizado em <time datetime={updatedDate.toISOString().slice(0, 10)}>{fmt(updatedDate)}</time></>}
          · {minutes} min de leitura
        </p>
      </div>
    </header>

    <div class="container-x grid max-w-6xl gap-12 lg:grid-cols-[1fr_15rem]">
      <div class="prosa max-w-3xl min-w-0"><slot /></div>
      {toc.length > 2 && (
        <aside class="hidden lg:block">
          <nav aria-label="Neste artigo" class="sticky top-24 text-sm">
            <p class="font-semibold">Neste artigo</p>
            <ul class="mt-3 grid gap-2 border-l border-linha pl-4 text-texto">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="hover:text-roxo">{h.text}</a></li>)}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <div class="container-x max-w-3xl">
      <div class="cartao mt-14 flex flex-col gap-5 p-7 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-semibold">Quer ver isso funcionando no seu WhatsApp?</p>
          <p class="mt-1 text-texto">Converse com o Axon e peça um diagnóstico gratuito.</p>
        </div>
        <CtaWhatsApp origem={origem} label="Falar com o Axon" class="shrink-0" />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="container-x mt-20 max-w-6xl" aria-labelledby="relacionados">
      <h2 id="relacionados" class="titulo text-3xl sm:text-4xl">Continue lendo</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {related.map((r) => (
          <li><a href={`/blog/${r.id}/`} class="cartao block h-full p-6 transition-transform hover:-translate-y-1"><h3 class="font-semibold">{r.data.title}</h3><p class="mt-2 line-clamp-3 text-sm text-texto">{r.data.description}</p></a></li>
        ))}
      </ul>
    </section>
  )}

  <FinalCta origem={`${origem}-final`} />
</Base>
