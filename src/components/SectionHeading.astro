---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; id?: string }
const { eyebrow, title, lead, center = false, id } = Astro.props;
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class="text-sm font-semibold tracking-wide text-roxo uppercase">{eyebrow}</p>}
  <h2 id={id} class="titulo mt-3 text-4xl sm:text-5xl" set:html={title} />
  {lead && <p class="mt-4 text-lg leading-relaxed text-texto">{lead}</p>}
</div>
