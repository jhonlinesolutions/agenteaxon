---
import { SITE } from '../config/site';

export interface Breadcrumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  breadcrumbs?: Breadcrumb[];
  type?: 'website' | 'article';
}

const { title, description, path, ogImage = '/og/axon.png', noindex = false, jsonLd = [], breadcrumbs, type = 'website' } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: 'Axon',
  legalName: SITE.company.legalName,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/axon-logo.webp`,
  email: SITE.email,
  taxID: SITE.company.cnpj,
  parentOrganization: { '@type': 'Organization', name: SITE.company.legalName, url: SITE.company.url },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.company.street,
    addressLocality: SITE.company.city,
    addressRegion: SITE.company.region,
    postalCode: SITE.company.postalCode,
    addressCountry: 'BR',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: `+${SITE.whatsapp}`,
    availableLanguage: 'Portuguese',
    areaServed: 'BR',
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: 'Axon',
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbList = breadcrumbs && {
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Início', path: '/' }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.path, SITE.url).href,
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...(breadcrumbList ? [breadcrumbList] : []), ...jsonLd],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Axon" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
