---
import { SITE } from '../config/site';
---
<!--
  GA4, Google Ads e Meta Pixel: as filas (dataLayer/fbq) existem desde o início, então PageView e cliques
  são registrados mesmo antes de os scripts chegarem. Os scripts só carregam na primeira interação ou após 4s,
  para não pesar no carregamento da página.
-->
<script is:inline define:vars={{ ga4: SITE.ga4, ads: SITE.adsId, pixel: SITE.pixelId }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };
  gtag('js', new Date());
  gtag('config', ga4);
  gtag('config', ads);

  var n = (window.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); });
  if (!window._fbq) window._fbq = n;
  n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
  fbq('init', pixel);
  fbq('track', 'PageView');

  var carregado = false;
  function carregar() {
    if (carregado) return;
    carregado = true;
    ['https://www.googletagmanager.com/gtag/js?id=' + ga4, 'https://connect.facebook.net/en_US/fbevents.js'].forEach(function (src) {
      var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s);
    });
  }
  ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
    window.addEventListener(ev, carregar, { once: true, passive: true });
  });
  setTimeout(carregar, 4000);

  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('[data-wa-origem]');
    if (!a) return;
    var origem = a.getAttribute('data-wa-origem');
    gtag('event', 'whatsapp_click', { origem: origem });
    fbq('track', 'Lead', { content_name: origem });
    carregar();
  });
</script>
