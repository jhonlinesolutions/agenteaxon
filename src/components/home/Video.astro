---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

const id = 'eitwil64aTw';
---
<section class="container-x py-24" aria-labelledby="video">
  <SectionHeading id="video" eyebrow="Veja em ação" title="Uma conversa real com o Axon" lead="Sem edição e sem roteiro. Assista e depois teste você mesmo: é só mandar um “oi”." center />
  <div class="relative mx-auto mt-12 max-w-4xl" data-reveal>
    <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-roxo/25 to-ciano/25 blur-2xl" aria-hidden="true"></div>
    <button
      type="button"
      data-video={id}
      class="group relative block aspect-video w-full overflow-hidden rounded-3xl border border-white bg-tinta shadow-2xl"
      aria-label="Assistir ao vídeo do Axon em ação"
    >
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105" />
      <span class="absolute inset-0 bg-gradient-to-t from-tinta/60 to-transparent"></span>
      <span class="absolute top-1/2 left-1/2 grid size-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white/95 text-roxo shadow-xl transition-transform duration-300 group-hover:scale-110">
        <Icon name="play" class="ml-1 size-8 fill-current" />
      </span>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.video}?autoplay=1&rel=0`;
      iframe.title = 'Axon em ação';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'aspect-video w-full rounded-3xl shadow-2xl';
      btn.replaceWith(iframe);
    });
  });
</script>
