---
interface Props { numero: number; titulo: string; texto: string }
const { numero, titulo, texto } = Astro.props;
---
<li class="cartao flex flex-col p-5" data-script data-reveal>
  <div class="flex items-center gap-3">
    <span class="grid size-7 shrink-0 place-items-center rounded-full bg-roxo-50 text-xs font-bold text-roxo">{numero}</span>
    <h3 class="font-semibold">{titulo}</h3>
  </div>
  <p class="mt-3 flex-1 rounded-xl bg-fundo p-4 text-[15px] leading-relaxed text-texto select-all" data-script-text>{texto}</p>
  <button type="button" data-copy class="mt-3 self-start rounded-lg px-3 py-1.5 text-sm font-semibold text-roxo transition-colors hover:bg-roxo-50">
    Copiar mensagem
  </button>
</li>
