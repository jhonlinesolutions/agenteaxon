---
import { waLink } from '../lib/whatsapp';
import IconWhatsApp from './IconWhatsApp.astro';

interface Props { origem: string }
const { origem } = Astro.props;
---
<a
  href={waLink(origem)}
  target="_blank"
  rel="noopener"
  data-wa-float
  data-wa-origem={origem}
  aria-label="Conversar com o Axon no WhatsApp"
  class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-[#25d366] text-white shadow-[0_14px_30px_-10px_rgb(37_211_102/.7)] transition-transform duration-300 hover:scale-105 sm:right-6 sm:bottom-6"
>
  <span class="absolute inset-0 animate-ping rounded-full bg-[#25d366] opacity-25 motion-reduce:hidden"></span>
  <IconWhatsApp class="relative size-7" />
</a>
