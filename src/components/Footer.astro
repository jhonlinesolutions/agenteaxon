---
import { Image } from 'astro:assets';
import logo from '../assets/axon-logo.webp';
import { FOOTER_LINKS, SITE } from '../config/site';
import { waLink } from '../lib/whatsapp';

interface Props { path: string }
const { path } = Astro.props;
const ano = new Date().getFullYear();
---
<footer class="relative mt-24 overflow-hidden border-t border-linha bg-white">
  <div class="orbe -bottom-40 left-1/3 size-80 bg-roxo-100" aria-hidden="true"></div>
  <div class="container-x relative grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-semibold">
        <Image src={logo} alt="" width={36} height={36} densities={[1, 2, 3]} class="size-9" />
        <span class="text-lg">Axon</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-texto">
        Agente de IA que atende seus clientes no WhatsApp na hora, 24 horas por dia, com o jeito e o conhecimento do seu negócio.
      </p>
    </div>

    <nav aria-label="Rodapé">
      <h2 class="text-sm font-semibold">Navegação</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm text-texto md:grid-cols-1">
        {FOOTER_LINKS.map((l) => <li><a href={l.href} class="hover:text-roxo">{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold">Contato</h2>
      <ul class="mt-4 grid gap-2.5 text-sm text-texto">
        <li><a href={waLink(`rodape${path}`)} target="_blank" rel="noopener" data-wa-origem={`rodape${path}`} class="hover:text-roxo">WhatsApp {SITE.whatsappDisplay}</a></li>
        <li><a href={`mailto:${SITE.email}`} class="break-all hover:text-roxo">{SITE.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-linha">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-suave md:flex-row md:items-center md:justify-between">
      <p>© {ano} {SITE.company.legalName} · CNPJ {SITE.company.cnpj} · {SITE.company.city} – {SITE.company.region}</p>
      <p>Desenvolvido por <a href={SITE.company.url} target="_blank" rel="noopener" class="font-medium text-roxo hover:underline">JH Online Solutions</a>, tecnologia que move o seu negócio adiante</p>
    </div>
  </div>
</footer>
